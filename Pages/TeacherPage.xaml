<Page x:Class="Kreta_WPF.Pages.TeacherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kreta_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="320" d:DesignWidth="800"
      Title="TeacherPage">

    <Page.Resources>
        <Style x:Key="h1Label" TargetType="Control">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0">
            <UniformGrid Columns="5">
                <Image></Image>
                <Button Content="Órarend" Tag="ttFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
                <Button Content="Osztályzat hozzáadása" Tag="grFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
                <Button Content="Mulasztás rögzítése" Tag="miFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
                <Button Content="Feladatok felvétele" Tag="hwFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
            </UniformGrid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="ttFrame" Tag="contentFrame" Visibility="Collapsed">
            <Border BorderBrush="Black" BorderThickness="0.5" Margin="10">
                <Grid Tag="10_6" Name="ttTable"  Initialized="generateRowsColumnsByTag">
                    <Grid.Resources>
                        <Style x:Key="baseLabel" TargetType="Label">
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="BorderBrush" Value="Black"/>
                            <Setter Property="BorderThickness" Value="0.5" />
                        </Style>
                        <Style x:Key="headerLabel" TargetType="Label" BasedOn="{StaticResource baseLabel}">
                            <Setter Property="Background" Value="AliceBlue"/>
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="20"/>
                        </Style>
                    </Grid.Resources>
                    <Label Content="" Grid.Column="0" Grid.Row="0" Style="{StaticResource headerLabel}"/>
                    <Label Content="Hetfő" Grid.Column="1" Grid.Row="0" Style="{StaticResource headerLabel}"/>
                    <Label Content="Kedd" Grid.Column="2" Grid.Row="0" Style="{StaticResource headerLabel}"/>
                    <Label Content="Szerda" Grid.Column="3" Grid.Row="0" Style="{StaticResource headerLabel}"/>
                    <Label Content="Csütörtök" Grid.Column="4" Grid.Row="0" Style="{StaticResource headerLabel}"/>
                    <Label Content="Péntek" Grid.Column="5" Grid.Row="0" Style="{StaticResource headerLabel}"/>

                    <Label Content="0. óra" Grid.Column="0" Grid.Row="1" Style="{StaticResource headerLabel}"/>
                    <Label Content="1. óra" Grid.Column="0" Grid.Row="2" Style="{StaticResource headerLabel}"/>
                    <Label Content="2. óra" Grid.Column="0" Grid.Row="3" Style="{StaticResource headerLabel}"/>
                    <Label Content="3. óra" Grid.Column="0" Grid.Row="4" Style="{StaticResource headerLabel}"/>
                    <Label Content="4. óra" Grid.Column="0" Grid.Row="5" Style="{StaticResource headerLabel}"/>
                    <Label Content="5. óra" Grid.Column="0" Grid.Row="6" Style="{StaticResource headerLabel}"/>
                    <Label Content="6. óra" Grid.Column="0" Grid.Row="7" Style="{StaticResource headerLabel}"/>
                    <Label Content="7. óra" Grid.Column="0" Grid.Row="8" Style="{StaticResource headerLabel}"/>
                    <Label Content="8. óra" Grid.Column="0" Grid.Row="9" Style="{StaticResource headerLabel}"/>
                    <UniformGrid Name="ttClassesGrid" Rows="9" Columns="5" Grid.Column="1" Grid.ColumnSpan="8" Grid.Row="1" Grid.RowSpan="9">

                    </UniformGrid>
                </Grid>
            </Border>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="grFrame" Tag="contentFrame" Visibility="Collapsed">
            <Border Margin="10" BorderBrush="Black" BorderThickness="0.5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <UniformGrid Columns="16" Rows="1" Grid.Row="0">
                        <Label Content="#" />
                        <Label Content="Tantárgy" />
                        <Label Content="09" />
                        <Label Content="10"/>
                        <Label Content="11"/>
                        <Label Content="12"/>
                        <Label Content="01/I"/>
                        <Label Content="I"/>
                        <Label Content="01/II"/>
                        <Label Content="02"/>
                        <Label Content="03"/>
                        <Label Content="04"/>
                        <Label Content="05"/>
                        <Label Content="06"/>
                        <Label Content="II"/>
                        <Label Content="Átlag"/>
                    </UniformGrid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1">
                        <StackPanel Name="gradeGrid" Orientation="Vertical">
                            <UniformGrid Columns="16" Rows="1">
                                <Label Content="1" />
                                <Label Content="Magyar" />
                                <Label Content="0" />
                                <Label Content="5 5 5" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="miFrame" Tag="contentFrame" Visibility="Visible">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Új Mulasztás Rögzítése" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1">
                    <Label Content="Osztály" />
                    <ComboBox Name="cbClasses" SelectionChanged="loadStudents" IsVisibleChanged="loadClasses">

                    </ComboBox>
                    <Label Content="Tanuló" />
                    <ComboBox Name="cbStudents">

                    </ComboBox>
                    <Label Content="Dátum" />
                    <DatePicker Name="absDp" />
                    <Label Content="Késés" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="minutesLate" Width="25" IsReadOnly="True">5</TextBox>
                        <StackPanel Width="25">
                            <Button Height="10" FontSize="5" Tag="5" Click="changeMinutesLate">▲</Button>
                            <Button Height="10" FontSize="5" Tag="-5" Click="changeMinutesLate">▼</Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Margin="0 20" Width="80" HorizontalAlignment="Right" Click="tryNewAbsence">Rögzítés</Button>
                    <Label VerticalContentAlignment="Top" HorizontalContentAlignment="Center" Name="lMessage" Grid.Row="4" Grid.Column="1" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="hwFrame" Tag="contentFrame" Visibility="Collapsed">
            <Grid Margin="10 20">
                
            </Grid>
        </ContentControl>
    </Grid>
</Page>
