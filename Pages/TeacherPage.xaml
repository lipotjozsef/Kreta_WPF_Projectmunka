<Page x:Class="Kreta_WPF.Pages.TeacherPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Kreta_WPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="320" d:DesignWidth="800"
      Title="TeacherPage">

    <Page.Resources>
        <Style x:Key="h1Label" TargetType="Control">
            <Setter Property="Background" Value="#BAD7E9" />
            <Setter Property="Foreground" Value="#2B3467"/>
            <Setter Property="BorderBrush" Value="#2B3467"/>
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="submitButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Green" />
            <Setter Property="Background" Value="#14baa0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="10, 5" />
        </Style> 
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" VerticalAlignment="Top">
            <UniformGrid Columns="4" MaxHeight="100">
                <Button Cursor="Hand" Padding="5" Background="#BAD7E9" BorderBrush="#2B3467" BorderThickness="1" Click="ReturnHome">
                    <Image Source="/Images/ceruzaImage.png"/>
                </Button>
                <Button Content="Új Osztályzatok" Tag="grFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
                <Button Content="Mulasztás rögzítése" Tag="miFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
                <Button Content="Feladatok felvétele" Tag="hwFrame" Click="menuButtonClick" Style="{StaticResource h1Label}"/>
            </UniformGrid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="grFrame" Tag="contentFrame" Visibility="Visible">
            <ContentControl.Resources>
                <Style x:Key="gradeButton" TargetType="RadioButton">
                    <Setter Property="Margin" Value="5, 0"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                </Style>
            </ContentControl.Resources>
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition />
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>
                <Label Content="Új érdemjegy rögzítése" Grid.Row="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="5"/>
                <ComboBox Name="grClassCB" Width="400" Grid.Row="1" IsVisibleChanged="loadClasses" SelectionChanged="loadStudentsGrade"  />
                <StackPanel Grid.Row="2" Width="400">
                    <Label Content="Dolgozat leírás"/>
                    <TextBox Height="50" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Margin="10, 5" BorderBrush="Black" BorderThickness="0.5" Grid.Row="3" Background="#BAD7E9">
                    <Border.Resources>
                        <Style TargetType="RadioButton">
                            <Setter Property="Foreground" Value="#2B3467"/>
                        </Style>
                        <Style TargetType="Label">
                            <Setter Property="Foreground" Value="#2B3467"/>
                        </Style>
                    </Border.Resources>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Name="gradeGrid" Orientation="Vertical" Margin="10, 5">
                                <!-- ** Template Card **
                                <UniformGrid Columns="4">
                                    <CheckBox />
                                    <Label Content="1" />
                                    <Label Content="Neve" />
                                    <StackPanel Orientation="Horizontal" Margin="0, 5" VerticalAlignment="Center">
                                        <RadioButton Content="1" Style="{StaticResource gradeButton}" />
                                        <RadioButton Content="2" Style="{StaticResource gradeButton}" />
                                        <RadioButton Content="3" Style="{StaticResource gradeButton}" />
                                        <RadioButton Content="4" Style="{StaticResource gradeButton}" />
                                        <RadioButton Content="5" Style="{StaticResource gradeButton}" />
                                    </StackPanel>
                                </UniformGrid>
                                -->
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Button Grid.Row="4" Width="80" Margin="20, 0" HorizontalAlignment="Right" Click="newGrading" Style="{StaticResource submitButton}">Rögzítés</Button>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="miFrame" Tag="contentFrame" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Új Mulasztás Rögzítése" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1">
                    <Label Content="Osztály" />
                    <ComboBox Name="cbClasses" SelectionChanged="loadStudents" IsVisibleChanged="loadClasses">

                    </ComboBox>
                    <Label Content="Tanuló" />
                    <ComboBox Name="cbStudents">

                    </ComboBox>
                    <Label Content="Dátum" />
                    <DatePicker Name="absDp" />
                    <Label Content="Késés" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Name="minutesLate" Width="25" IsReadOnly="True">5</TextBox>
                        <StackPanel Width="25">
                            <Button Height="10" FontSize="5" Tag="5" Click="changeMinutesLate">▲</Button>
                            <Button Height="10" FontSize="5" Tag="-5" Click="changeMinutesLate">▼</Button>
                        </StackPanel>
                    </StackPanel>
                    <Button Margin="0 20" Width="80" HorizontalAlignment="Right" Click="tryNewAbsence" Style="{StaticResource submitButton}">Rögzítés</Button>
                    <Label VerticalContentAlignment="Top" HorizontalContentAlignment="Center" Name="lMessage" Grid.Row="4" Grid.Column="1" />
                </StackPanel>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="hwFrame" Tag="contentFrame" Visibility="Collapsed">
            <Grid Margin="10 20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Új feladat rögzítése" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.RowSpan="4" Grid.Column="1">
                    <Label Content="Osztály" />
                    <ComboBox Name="hwClassCB" IsVisibleChanged="loadClasses" />
                    <Label Content="Feladat leírás" />
                    <TextBox TextWrapping="Wrap" Height="100" Foreground="#2B3467" Background="#BAD7E9"/>
                    <Button HorizontalAlignment="Right" Padding="10, 5" Margin="5, 20" Click="tryNewHomework" Style="{StaticResource submitButton}">Rözgzítés</Button>
                </StackPanel>
            </Grid>
        </ContentControl>
    </Grid>
</Page>
