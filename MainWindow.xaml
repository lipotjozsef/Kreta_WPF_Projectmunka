<Window x:Class="Kreta_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Kreta_WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.15*" />
            <RowDefinition />
        </Grid.RowDefinitions>
        
        <ContentControl Grid.Row="0">
            <UniformGrid Columns="6">
                <Image></Image>
                <Button Content="Órarend" Tag="ttFrame"/>
                <Button Content="Osztályzatok" Tag="grFrame"/>
                <Button Content="Mulasztások" Tag="miFrame"/>
                <Button Content="Információk" Tag="inFrame"/>
                <Button Content="Házi feladatok" Tag="hwFrame"/>
            </UniformGrid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="ttFrame" Tag="ContentFrame">
            <Grid>
                <Label Content="Ez az órarend felülete!" />
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="grFrame" Tag="ContentFrame" Visibility="Hidden">
            <Grid>
                <Label Content="Ez az osztályzatok felülete!" />
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="miFrame" Tag="ContentFrame" Visibility="Hidden">
            <Grid>
                <Label Content="Ez a mulasztások felülete!" />
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="inFrame" Tag="ContentFrame" Visibility="Hidden">
            <Grid>
                <Label Content="Ez az információ felülete!" />
            </Grid>
        </ContentControl>

        <ContentControl Grid.Row="1" Name="hwFrame" Tag="ContentFrame" Visibility="Hidden">
            <Grid>
                <Label Content="Ez az házi feladat felülete!" />
            </Grid>
        </ContentControl>
    </Grid>
</Window>
